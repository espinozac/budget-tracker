# Server defaults (every value has a default; the server starts with no .env)
PORT=3001
DATA_FILE=./data/transactions.json
ALLOW_FUTURE_DATES=true

# Optional AI category suggestions (OpenAI-compatible chat completions)
# Code defaults when unset: LLM_BASE_URL=https://api.x.ai/v1, LLM_MODEL=grok-4.7,
# and a takehome-only demo API key in server/src/llm.ts (NEVER do that in production).
# Omit LLM_API_KEY to use the takehome default. Set LLM_API_KEY= (empty) for history only.
# Prefer your own key: LLM_API_KEY=...
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
# LLM_API_KEY=
